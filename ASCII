
#include <iostream>
using namespace std;

int main() {
    char ch;

    cout << "Enter an English character (a-z, A-Z): ";
    cin >> ch;

    if ((ch >= 'a' && ch <= 'z') ||
        (ch >= 'A' && ch <= 'Z')) {
        cout << "ASCII value of " << ch
             << " is " << int(ch);
    }
    else {
        cout << "Invalid character!";
    }

    return 0;
}
