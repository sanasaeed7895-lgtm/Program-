
#include <iostream>
using namespace std;

int main() {
    int a[100], b[100], n, choice;
    int sum, large, small;
    long long product;
    double average;

    cout << "Enter number of elements: ";
    cin >> n;

    cout << "Enter elements of first array:\n";
    for (int i = 0; i < n; i++)
        cin >> a[i];

    cout << "\n1. Addition of two arrays";
    cout << "\n2. Subtraction of two arrays";
    cout << "\n3. Multiplication of array elements";
    cout << "\n4. Find largest and smallest element";
    cout << "\n5. Calculate sum and average";
    cout << "\nEnter your choice: ";
    cin >> choice;

    switch (choice) {
        case 1:
            cout << "Enter elements of second array:\n";
            for (int i = 0; i < n; i++)
                cin >> b[i];

            cout << "Addition: ";
            for (int i = 0; i < n; i++)
                cout << a[i] + b[i] << " ";
            break;

        case 2:
            cout << "Enter elements of second array:\n";
            for (int i = 0; i < n; i++)
                cin >> b[i];

            cout << "Subtraction: ";
            for (int i = 0; i < n; i++)
                cout << a[i] - b[i] << " ";
            break;

        case 3:
            product = 1;
            cout << "Multiplication of elements: ";
            for (int i = 0; i < n; i++) {
                product *= a[i];
            }
            cout << product;
            break;

        case 4:
            large = small = a[0];

            for (int i = 1; i < n; i++) {
                if (a[i] > large)
                    large = a[i];
                if (a[i] < small)
                    small = a[i];
            }

            cout << "Largest element: " << large;
            cout << "\nSmallest element: " << small;
            break;

        case 5:
            sum = 0;
            for (int i = 0; i < n; i++)
                sum += a[i];

            average = (double)sum / n;

            cout << "Sum: " << sum;
            cout << "\nAverage: " << average;
            break;

        default:
            cout << "Invalid choice!";
    }

    return 0;
}
