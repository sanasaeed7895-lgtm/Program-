
#include <iostream>
#include <cmath>
using namespace std;

int main() {
    float a, b, c, d, root1, root2;

    cout << "Enter coefficients a, b and c: ";
    cin >> a >> b >> c;

    if (a == 0) {
        cout << "Not a quadratic equation.";
        return 0;
    }

    d = b * b - 4 * a * c;

    if (d > 0) {
        root1 = (-b + sqrt(d)) / (2 * a);
        root2 = (-b - sqrt(d)) / (2 * a);

        cout << "Two distinct real roots: "
             << root1 << " and " << root2;
    }
    else if (d == 0) {
        root1 = -b / (2 * a);
        cout << "Two equal roots: " << root1;
    }
    else {
        cout << "Roots are complex.";
        cout << "\nReal part: " << -b / (2 * a);
        cout << "\nImaginary part: "
             << sqrt(-d) / (2 * a);
    }

    return 0;
}
